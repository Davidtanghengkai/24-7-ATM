# Server
PORT=3000

# Database
DB_SERVER=localhost
DB_PORT=5432
DB_DATABASE=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# IBM Watson Assistant
WATSON_ASSISTANT_APIKEY=your_watson_api_key
WATSON_ASSISTANT_URL=https://api.example.com
WATSON_ASSISTANT_ID=your_assistant_id
WATSON_ASSISTANT_ENV_ID=your_environment_id

# Email
EMAIL_LOGIN=your_email_login
EMAIL_PASS=your_email_password
EMAIL_USER=your_email_address

# Auth / Sessions
SESSION_SECRET=your_session_secret_here
JWT_SECRET=your_jwt_secret_here

# Google Cloud
GOOGLE_PROJECT_ID=your_project_id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# RapidAPI
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=your_rapidapi_host

# Blockchain / Web3
SEPOLIA_RPC_URL=https://your_rpc_url
PRIVATE_KEY=your_private_key_here
LEDGER_ADDRESS=your_ledger_address
